# Server port (Render injects PORT automatically)
PORT=3001

# Gemini API key — get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Neon Postgres connection string (optional — episodes fall back to in-memory without it)
DATABASE_URL=

# Public URL of the frontend (PWA). Used for CORS. e.g. https://koola10-studio-app.onrender.com
FRONTEND_URL=

# Path to the universe lore bible used by /studio/lore
LORE_PATH=../episodes/universe/scripts/MASTER_BIBLE.md
